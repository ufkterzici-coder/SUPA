{
  "version": "1.0",
  "project": {
    "name": "SUPA Blog Automation",
    "niche": "Kişisel Finans ve Bütçe Yönetimi",
    "language": "tr",
    "brand_voice": "Samimi, eğitici, profesyonel",
    "target_audience": "Türkiye'deki genç profesyoneller ve tasarruf yapanlar"
  },

  "api_configuration": {
    "gemini": {
      "api_key_env": "GEMINI_API_KEY",
      "model": "gemini-pro",
      "image_model": "imagen-3.0-generate-001",
      "max_tokens": 8000,
      "temperature": 0.7
    }
  },

  "external_mcps": [
    {
      "name": "gemini-mcp",
      "description": "Google Gemini API entegrasyonu - Görsel oluşturma ve gelişmiş AI işlemleri",
      "available_tools": [
        "generate_image",
        "generate_content",
        "analyze_image"
      ],
      "priority": "high"
    },
    {
      "name": "firecrawl-mcp",
      "description": "Web scraping ve rakip içerik analizi",
      "available_tools": [
        "scrape_url",
        "crawl_site",
        "extract_content"
      ],
      "priority": "medium"
    },
    {
      "name": "seo-research-mcp",
      "description": "SEO veri API'leri - Ahrefs, Semrush entegrasyonu",
      "available_tools": [
        "get_keyword_data",
        "analyze_serp",
        "get_backlinks",
        "keyword_difficulty"
      ],
      "priority": "medium"
    }
  ],

  "tool_instructions": [
    {
      "tool_name": "keyword_research",
      "composition_hints": "OTOMATIK SÜREÇ: 1) EĞER seo-research-mcp mevcutsa, get_keyword_data ile gerçek arama hacmi verilerini al (Ahrefs/Semrush). 2) Türkiye pazarına özgü keyword varyasyonları ekle. 3) Zorluk skorlarını API verilerine göre hesapla. 4) EĞER competitor_domain verilmişse, firecrawl-mcp ile rakip içerik yapısını tara ve keyword gap analizi yap.",
      "auto_enhance": true,
      "output_format": "detailed_clusters"
    },
    {
      "tool_name": "seo_strategy",
      "composition_hints": "OTOMATIK SÜREÇ: 1) Target keyword için seo-research-mcp ile SERP analizi yap (top 10 sayfaların kelime sayısı, başlık yapısı, domain authority). 2) Firecrawl-mcp ile en iyi 3 sayfayı detaylı tara ve içerik boşluklarını tespit et. 3) Rakiplerden %20 daha uzun ve kapsamlı içerik stratejisi oluştur. 4) Türkçe içerik için lokal SEO önerilerini ekle.",
      "auto_enhance": true,
      "include_competitor_analysis": true
    },
    {
      "tool_name": "content_write",
      "composition_hints": "OTOMATIK SÜREÇ: 1) Yazmadan ÖNCE seo_strategy çağır ve detaylı brief al. 2) EĞER target_keyword belirtilmişse, firecrawl-mcp ile top 3 rakip sayfayı tara ve içerik kalitesini analiz et. 3) Blog yazısını oluştururken Türkçe dilbilgisi ve akıcılığa özen göster. 4) YAZDIĞINDA SONRA image_prompt ile hero image ve section image'lar için prompt oluştur. 5) İçeriğe otomatik internal link önerileri ekle.",
      "auto_enhance": true,
      "auto_generate_images": true,
      "language_optimization": "turkish"
    },
    {
      "tool_name": "image_prompt",
      "composition_hints": "OTOMATIK SÜREÇ: 1) Optimized prompt oluşturduktan SONRA, EĞER gemini-mcp mevcutsa otomatik olarak generate_image aracını çağır. 2) Görseli oluştur ve base64 veya URL olarak döndür. 3) Alt text'i Türkçe olarak oluştur. 4) EĞER birden fazla görsel gerekiyorsa (section images), batch process yap.",
      "auto_generate": true,
      "default_aspect_ratio": "16:9",
      "default_style": "modern flat illustration"
    },
    {
      "tool_name": "internal_links",
      "composition_hints": "OTOMATIK SÜREÇ: 1) Mevcut içerik sitemap'ini analiz et. 2) Semantik olarak ilgili sayfaları bul. 3) Natural anchor text önerileri oluştur (aşırı optimize edilmiş değil). 4) EĞER seo-research-mcp mevcutsa, rakiplerin internal linking stratejisini incele.",
      "auto_enhance": true
    }
  ],

  "automated_workflows": {
    "complete_blog_post": {
      "description": "Keyword araştırmasından görsellere kadar tam otomatik blog oluşturma",
      "steps": [
        {
          "step": 1,
          "tool": "keyword_research",
          "params": {
            "seed_keyword": "{{user_topic}}",
            "content_goal": "traffic"
          },
          "output_var": "keywords"
        },
        {
          "step": 2,
          "tool": "seo_strategy",
          "params": {
            "target_keyword": "{{keywords.primary_keyword}}",
            "content_type": "guide"
          },
          "output_var": "strategy"
        },
        {
          "step": 3,
          "tool": "content_write",
          "params": {
            "target_keyword": "{{strategy.target_keyword}}",
            "outline": "{{strategy.content_brief.outline}}",
            "tone": "{{project.brand_voice}}"
          },
          "output_var": "blog_content"
        },
        {
          "step": 4,
          "tool": "image_prompt",
          "params": {
            "subject": "{{blog_content.title}}",
            "image_purpose": "hero",
            "mood": "modern and professional"
          },
          "output_var": "hero_prompt",
          "auto_execute": "gemini_generate_image"
        },
        {
          "step": 5,
          "tool": "image_prompt",
          "params": {
            "subject": "{{blog_content.sections}}",
            "image_purpose": "section",
            "mood": "clean and educational"
          },
          "output_var": "section_prompts",
          "auto_execute": "gemini_generate_images_batch"
        },
        {
          "step": 6,
          "tool": "internal_links",
          "params": {
            "content": "{{blog_content.content}}",
            "sitemap": "auto_detect"
          },
          "output_var": "link_suggestions"
        }
      ],
      "final_output": {
        "format": "json",
        "includes": [
          "blog_content",
          "hero_image",
          "section_images",
          "seo_metadata",
          "internal_links",
          "keyword_report"
        ]
      }
    },

    "quick_blog_post": {
      "description": "Hızlı blog yazısı (görselsiz, temel SEO)",
      "steps": [
        {
          "step": 1,
          "tool": "seo_strategy",
          "params": {
            "target_keyword": "{{user_keyword}}"
          }
        },
        {
          "step": 2,
          "tool": "content_write",
          "params": {
            "target_keyword": "{{user_keyword}}"
          }
        }
      ]
    },

    "seo_audit_and_content": {
      "description": "Rakip analizi + içerik üretimi",
      "steps": [
        {
          "step": 1,
          "tool": "keyword_research",
          "params": {
            "seed_keyword": "{{user_topic}}",
            "competitor_domain": "{{competitor_url}}"
          }
        },
        {
          "step": 2,
          "tool": "seo_strategy",
          "params": {
            "target_keyword": "{{keywords.gap_opportunities[0]}}"
          }
        },
        {
          "step": 3,
          "tool": "content_write",
          "auto_enhance": true
        }
      ]
    },

    "social_media_content": {
      "description": "Blog + sosyal medya görselleri paketi",
      "steps": [
        {
          "step": 1,
          "tool": "content_write",
          "params": {
            "target_keyword": "{{user_keyword}}",
            "tone": "conversational"
          }
        },
        {
          "step": 2,
          "tool": "image_prompt",
          "params": {
            "subject": "{{blog_content.title}}",
            "image_purpose": "social",
            "mood": "vibrant and energetic"
          },
          "variations": ["instagram_square", "twitter_card", "linkedin_post"]
        }
      ]
    }
  },

  "optimization_rules": {
    "turkish_seo": {
      "enabled": true,
      "rules": [
        "Use Turkish characters correctly (ı, ş, ğ, ü, ö, ç)",
        "Prefer Turkish keywords over English when targeting TR audience",
        "Include local context (Turkish market, currency TL, local examples)",
        "Natural language, avoid keyword stuffing",
        "Use formal 'siz' form in professional content"
      ]
    },
    "content_quality": {
      "minimum_word_count": 1500,
      "maximum_keyword_density": 2.5,
      "readability_target": "B2_level",
      "include_examples": true,
      "include_visuals": true
    },
    "seo_technical": {
      "title_length": "50-60",
      "meta_description_length": "150-160",
      "h1_count": 1,
      "h2_minimum": 4,
      "internal_links_minimum": 3,
      "external_links_minimum": 2
    }
  },

  "default_keywords": [
    "kişisel finans",
    "bütçe yönetimi",
    "para biriktirme",
    "tasarruf yöntemleri",
    "finansal planlama",
    "yatırım stratejileri",
    "borç yönetimi"
  ],

  "output_preferences": {
    "default_format": "json",
    "include_metadata": true,
    "include_analytics": true,
    "language": "tr",
    "encoding": "utf-8"
  }
}
